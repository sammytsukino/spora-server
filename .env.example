# =============================================================================
# SPORA SERVER — PLANTILLA DE ENTORNO
# =============================================================================
#
# 1. Copia este archivo como `.env` en la raíz de spora-server (junto a index.js).
# 2. Rellena TODAS las variables marcadas como OBLIGATORIAS antes de desplegar.
# 3. No subas `.env` a Git (contiene secretos).
#
# En Render / Vercel / producción: pega las mismas claves en el panel de
# Environment Variables del servicio backend.
#
# ⚠️  Si omites variables “recomendadas”, la app ARRANCA pero pierde funciones
#     visibles del TFG (miniaturas en Garden, avatares, contacto, voz…).
#
# Guía ampliada: README.md → sección “Environment Variables”.
# =============================================================================


# -----------------------------------------------------------------------------
# ENTORNO DE EJECUCIÓN
# -----------------------------------------------------------------------------
# Dónde: valor local `development`; en Render/producción usar `production`.
# Por qué: activa reglas de seguridad (CORS estricto, cookies cross-site, etc.).
NODE_ENV=development


# -----------------------------------------------------------------------------
# PUERTO DEL API
# -----------------------------------------------------------------------------
# Dónde: localmente 4000; Render asigna PORT automáticamente (no lo hardcodees).
# Por qué: el cliente (VITE_API_BASE_URL) debe apuntar a este puerto/host.
PORT=4000


# =============================================================================
# OBLIGATORIAS — SIN ESTAS EL BACKEND NO FUNCIONA EN PRODUCCIÓN
# =============================================================================


# -----------------------------------------------------------------------------
# MONGODB — BASE DE DATOS (OBLIGATORIA en producción)
# -----------------------------------------------------------------------------
# Dónde obtenerla:
#   • MongoDB Atlas → https://www.mongodb.com/cloud/atlas
#     Cluster → Connect → “Drivers” → copia la URI SRV.
#   • Local (solo dev): mongodb://localhost:27017/sporadb
#
# Por qué es CRÍTICA:
#   Persiste usuarios, floras, lineage, reports, follows y todo el ecosistema.
#   Sin MongoDB no hay registro, login, Garden, Laboratory ni perfiles.
#
# Formato: mongodb+srv://USUARIO:CONTRASEÑA@cluster.mongodb.net/sporadb
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/sporadb
# Alias aceptado por la app (usa uno u otro, no hace falta duplicar):
# MONGO_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/sporadb


# -----------------------------------------------------------------------------
# JWT_SECRET — FIRMA DE SESIONES (OBLIGATORIA)
# -----------------------------------------------------------------------------
# Dónde obtenerla:
#   Genera una cadena aleatoria ≥ 32 caracteres (nunca reutilices contraseñas).
#   Ejemplo en terminal: openssl rand -base64 48
#
# Por qué es CRÍTICA:
#   Firma access tokens y refresh tokens. Sin ella el servidor no arranca bien
#   y nadie puede iniciar sesión de forma segura.
JWT_SECRET=change_me_min_32_chars_random_string________


# -----------------------------------------------------------------------------
# CORS_ORIGIN — ORIGENES DEL FRONTEND (OBLIGATORIA en producción)
# -----------------------------------------------------------------------------
# Dónde obtenerla:
#   URL pública del cliente Vite (Vercel, Netlify, etc.), SIN barra final.
#   Local: http://localhost:5173 (puerto por defecto de Vite).
#   Varios entornos: separados por coma.
#
# Por qué es CRÍTICA:
#   El navegador bloquea peticiones API si el origen no está en la lista.
#   Síntoma típico: login/signup falla, Garden vacío, errores CORS en consola.
#   En producción NUNCA uses `*` con cookies de refresh.
#
# Ejemplo despliegue:
# CORS_ORIGIN=https://tu-spora.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174


# -----------------------------------------------------------------------------
# FRONTEND_URL — URL PÚBLICA DE LA SPA (OBLIGATORIA en producción)
# -----------------------------------------------------------------------------
# Dónde obtenerla: misma URL base del cliente (sin /api).
#
# Por qué es CRÍTICA:
#   Enlaces en emails transaccionales y redirecciones post-acción.
#   Debe coincidir con la URL real donde vive spora-client.
FRONTEND_URL=http://localhost:5173


# =============================================================================
# MUY RECOMENDADAS PARA EL TFG — LA APP “FUNCIONA” SIN ELLAS PERO SE ROMPE
# LA EXPERIENCIA COMPLETA (ESPECIALMENTE CLOUDINARY)
# =============================================================================


# -----------------------------------------------------------------------------
# CLOUDINARY — ALMACENAMIENTO DE IMÁGENES DE USUARIO Y FLORAS
# ⚠️  NO ES OPCIONAL PARA UNA DEMO/TFG COMPLETA
# -----------------------------------------------------------------------------
# Dónde obtener las tres claves (Dashboard → Product environment settings):
#   https://cloudinary.com/console
#   • CLOUDINARY_CLOUD_NAME  → “Cloud name”
#   • CLOUDINARY_API_KEY     → “API Key”
#   • CLOUDINARY_API_SECRET  → “API Secret” (solo backend, nunca en el cliente)
#
# Plan gratuito suficiente para TFG (cuota generosa de transformaciones/almacenamiento).
#
# Por qué es CRÍTICA para SPORA (aunque el código no “crashee” sin ella):
#
#   1. MINIATURAS AL PUBLICAR FLORAS
#      Al guardar desde el Laboratory, el canvas se captura y se sube a Cloudinary.
#      Sin estas claves → la flora se crea PERO thumbnailUrl queda vacío.
#      Efecto visible: tarjetas del Garden/Greenhouse/perfil SIN imagen generada
#      (solo placeholders genéricos). Pierdes el argumento visual del TFG.
#
#   2. AVATARES DE PERFIL
#      PATCH /api/auth/me con avatarData sube la foto a Cloudinary.
#      Sin claves → el avatar no se persiste en la nube.
#
#   3. RENDIMIENTO Y ENTREGA
#      Las URLs de Cloudinary permiten transformaciones (tamaño, calidad, formato).
#      El cliente optimiza thumbnails vía res.cloudinary.com/…/upload/…
#
#   4. SEPARACIÓN FRONT/BACK
#      Los assets estáticos del repo (logo, vídeos demo) ya usan una cuenta Cloudinary
#      del proyecto; las floras NUEVAS de cada cultivador necesitan TU cuenta activa
#      en el backend para generar sus propias miniaturas.
#
# Conclusión para evaluación: omitir Cloudinary = plataforma publicable pero
# visualmente incompleta. Configúrala para demostrar el ciclo completo
# Laboratory → miniatura → Garden → Reader.
#
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# -----------------------------------------------------------------------------
# SMTP — CORREO (FORMULARIO DE CONTACTO Y ALERTAS ADMIN)
# -----------------------------------------------------------------------------
# Dónde obtenerla:
#   • Gmail: cuenta + “Contraseña de aplicación” (Google Account → Seguridad)
#   • SendGrid, Mailgun, Brevo, etc.: credenciales SMTP del panel
#   • Render: algunos planes incluyen SMTP o usa un servicio externo
#
# Por qué importa:
#   POST /api/contact envía el mensaje a emails de usuarios admin activos.
#   Sin SMTP → el formulario de Contact devuelve 503 / “email not configured”.
#   Las alertas de moderación tampoco llegan por correo.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM=SPORA <noreply@tudominio.com>


# =============================================================================
# OPCIONALES — COMPORTAMIENTO AVANZADO
# =============================================================================


# -----------------------------------------------------------------------------
# REFRESH_COOKIE_SAMESITE — COOKIE DE REFRESH EN DESPLIEGUES CROSS-DOMAIN
# -----------------------------------------------------------------------------
# Cuándo: cliente en un dominio (vercel.app) y API en otro (onrender.com).
# Valores: lax | none | strict
# Por defecto: production → none (requiere HTTPS); development → lax
# REFRESH_COOKIE_SAMESITE=none


# -----------------------------------------------------------------------------
# READER TTS (VoiPi) — VOZ EN FLORA READER
# -----------------------------------------------------------------------------
# No requiere API key en .env: el paquete voipi se resuelve en runtime en el servidor.
# Si falla (hosting sin soporte dynamic import): POST /api/reader/tts → 502.
# La app sigue usable; solo falla el botón de audio en desktop Reader.
