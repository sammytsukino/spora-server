# =============================================================================
# SPORA SERVER — ENVIRONMENT TEMPLATE
# =============================================================================
#
# 1. Copy this file to `.env` in the spora-server root (next to index.js).
# 2. Fill in ALL variables marked as REQUIRED before deploying.
# 3. Do not commit `.env` to Git (it contains secrets).
#
# On Render / Vercel / production: paste the same keys in the backend service
# Environment Variables panel.
#
# ⚠️  If you skip "recommended" variables, the app STARTS but loses visible
#     TFG features (Garden thumbnails, avatars, contact form, voice…).
#
# Extended guide: README.md → "Environment Variables" section.
# =============================================================================


# -----------------------------------------------------------------------------
# RUNTIME ENVIRONMENT
# -----------------------------------------------------------------------------
# Local: `development`; on Render/production use `production`.
# Enables security rules (strict CORS, cross-site cookies, etc.).
NODE_ENV=development


# -----------------------------------------------------------------------------
# API PORT
# -----------------------------------------------------------------------------
# Local: 4000; Render assigns PORT automatically (do not hardcode in production).
# The client (VITE_API_BASE_URL) must point to this port/host.
PORT=4000


# =============================================================================
# REQUIRED — WITHOUT THESE THE BACKEND DOES NOT WORK IN PRODUCTION
# =============================================================================


# -----------------------------------------------------------------------------
# MONGODB — DATABASE (REQUIRED in production)
# -----------------------------------------------------------------------------
# Where to get it:
#   • MongoDB Atlas → https://www.mongodb.com/cloud/atlas
#     Cluster → Connect → "Drivers" → copy the SRV URI.
#   • Local (dev only): mongodb://localhost:27017/sporadb
#
# Why it is CRITICAL:
#   Persists users, floras, lineage, reports, follows, and the full ecosystem.
#   Without MongoDB there is no signup, login, Garden, Laboratory, or profiles.
#
# Format: mongodb+srv://USER:PASSWORD@cluster.mongodb.net/sporadb
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/sporadb
# Accepted alias (use one or the other, no need to duplicate):
# MONGO_URL=mongodb+srv://USER:PASS@cluster.mongodb.net/sporadb


# -----------------------------------------------------------------------------
# JWT_SECRET — SESSION SIGNING (REQUIRED)
# -----------------------------------------------------------------------------
# Where to get it:
#   Generate a random string ≥ 32 characters (never reuse passwords).
#   Terminal example: openssl rand -base64 48
#
# Why it is CRITICAL:
#   Signs access and refresh tokens. Without it the server cannot start securely
#   and nobody can sign in safely.
JWT_SECRET=change_me_min_32_chars_random_string________


# -----------------------------------------------------------------------------
# CORS_ORIGIN — FRONTEND ORIGINS (REQUIRED in production)
# -----------------------------------------------------------------------------
# Where to get it:
#   Public Vite client URL (Vercel, Netlify, etc.), NO trailing slash.
#   Local: http://localhost:5173 (Vite default port).
#   Multiple environments: comma-separated.
#
# Why it is CRITICAL:
#   The browser blocks API requests if the origin is not in the list.
#   Typical symptom: login/signup fails, empty Garden, CORS errors in console.
#   In production NEVER use `*` with refresh cookies.
#
# Deployment example:
# CORS_ORIGIN=https://your-spora.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174


# -----------------------------------------------------------------------------
# FRONTEND_URL — PUBLIC SPA URL (REQUIRED in production)
# -----------------------------------------------------------------------------
# Where to get it: same base URL as the client (without /api).
#
# Why it is CRITICAL:
#   Links in transactional emails and post-action redirects.
#   Must match the URL where spora-client is actually hosted.
FRONTEND_URL=http://localhost:5173


# =============================================================================
# STRONGLY RECOMMENDED FOR THE TFG — THE APP "WORKS" WITHOUT THEM BUT THE
# FULL EXPERIENCE BREAKS (ESPECIALLY CLOUDINARY)
# =============================================================================


# -----------------------------------------------------------------------------
# CLOUDINARY — USER AND FLORA IMAGE STORAGE
# ⚠️  NOT OPTIONAL FOR A COMPLETE DEMO / TFG
# -----------------------------------------------------------------------------
# Where to get the three keys (Dashboard → Product environment settings):
#   https://cloudinary.com/console
#   • CLOUDINARY_CLOUD_NAME  → "Cloud name"
#   • CLOUDINARY_API_KEY     → "API Key"
#   • CLOUDINARY_API_SECRET  → "API Secret" (backend only, never in the client)
#
# Free tier is enough for the TFG (generous transform/storage quota).
#
# Why it is CRITICAL for SPORA (even though the code does not "crash" without it):
#
#   1. THUMBNAILS ON FLORA PUBLISH
#      When saving from the Laboratory, the canvas is captured and uploaded to Cloudinary.
#      Without these keys → the flora is created BUT thumbnailUrl stays empty.
#      Visible effect: Garden/Greenhouse/profile cards WITHOUT generative artwork
#      (generic placeholders only). You lose the visual argument of the TFG.
#
#   2. PROFILE AVATARS
#      PATCH /api/auth/me with avatarData uploads the photo to Cloudinary.
#      Without keys → the avatar is not persisted in the cloud.
#
#   3. PERFORMANCE AND DELIVERY
#      Cloudinary URLs allow transforms (size, quality, format).
#      The client optimizes thumbnails via res.cloudinary.com/…/upload/…
#
#   4. FRONT/BACK SEPARATION
#      Static repo assets (logo, demo videos) already use a project Cloudinary account;
#      NEW floras from each cultivator need YOUR active backend account to generate
#      their own thumbnails.
#
# Evaluation takeaway: omitting Cloudinary = publishable platform but visually
# incomplete. Configure it to demonstrate the full cycle
# Laboratory → thumbnail → Garden → Reader.
#
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# -----------------------------------------------------------------------------
# SMTP — EMAIL (CONTACT FORM AND ADMIN ALERTS)
# -----------------------------------------------------------------------------
# Where to get it:
#   • Gmail: account + "App password" (Google Account → Security)
#   • SendGrid, Mailgun, Brevo, etc.: SMTP credentials from their dashboard
#   • Render: some plans include SMTP or use an external service
#
# Why it matters:
#   POST /api/contact sends the message to active admin user emails.
#   Without SMTP → Contact form returns 503 / "email not configured".
#   Moderation alerts will not arrive by email either.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM=SPORA <noreply@yourdomain.com>


# =============================================================================
# OPTIONAL — ADVANCED BEHAVIOUR
# =============================================================================


# -----------------------------------------------------------------------------
# REFRESH_COOKIE_SAMESITE — REFRESH COOKIE ON CROSS-DOMAIN DEPLOYS
# -----------------------------------------------------------------------------
# When: client on one domain (vercel.app) and API on another (onrender.com).
# Values: lax | none | strict
# Default: production → none (requires HTTPS); development → lax
# REFRESH_COOKIE_SAMESITE=none


# -----------------------------------------------------------------------------
# READER TTS (VoiPi) — VOICE IN FLORA READER
# -----------------------------------------------------------------------------
# No API key in .env: the voipi package is resolved at runtime on the server.
# If it fails (hosting without dynamic import support): POST /api/reader/tts → 502.
# The app remains usable; only the desktop Reader audio button fails.
