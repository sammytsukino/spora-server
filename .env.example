# Copy to .env for local dev. On Render, set these in Environment.

NODE_ENV=development

# Required in production (Render / Atlas)
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/sporadb

# Required: signing access + refresh JWTs
JWT_SECRET=change_me_min_32_chars_random_string________

# Comma-separated browser origins allowed to call the API with credentials.
# Example: https://spora.vercel.app,https://spora-git-main-yourteam.vercel.app
CORS_ORIGIN=http://localhost:5173

# Public URL of the SPA (magic links, emails)
FRONTEND_URL=http://localhost:5173

# Optional: force refresh cookie SameSite (default: production=none, dev=lax)
# REFRESH_COOKIE_SAMESITE=lax

# Cloudinary (avatars / uploads) — optional if unused
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Email (contact form, admin report alerts) — optional; see src/services/emailService.js
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM=SPORA <noreply@yourdomain.com>

# Reader TTS — optional, powered by VoiPi
