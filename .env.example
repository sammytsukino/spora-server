# Copy to .env and fill in values.

JWT_SECRET=
MONGODB_URI=
CORS_ORIGIN=

# Flora Reader — text-to-speech (ElevenLabs). Both required or POST /api/reader/tts returns 503.
# https://elevenlabs.io → Profile/API key → copy key (starts with sk_ or similar).
# Voice ID: Voices → pick a voice → ID in the URL or voice settings (long alphanumeric).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional; default: eleven_multilingual_v2
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
